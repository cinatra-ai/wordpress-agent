{
  "name": "@cinatra-ai/wordpress-agent",
  "version": "0.1.7",
  "license": "Apache-2.0",
  "description": "Edits WordPress posts from natural language instructions via the WordPress MCP server.",
  "type": "module",
  "scripts": {
    "test": "sh -c \"node --test\""
  },
  "files": [
    "cinatra"
  ],
  "cinatra": {
    "apiVersion": "cinatra.ai/v1",
    "kind": "agent",
    "displayName": "WordPress Agent",
    "dependencies": [
      {
        "packageName": "@cinatra-ai/wordpress-mcp-connector",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.4"
        },
        "requirement": "required",
        "kind": "connector"
      },
      {
        "packageName": "@cinatra-ai/cms-snapshot-artifact",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.0"
        },
        "requirement": "required",
        "kind": "artifact"
      }
    ],
    "consumes": [
      {
        "primitive": "wordpress_site_tool_call",
        "requirement": "required"
      },
      {
        "primitive": "wordpress_site_tools_list",
        "requirement": "optional"
      }
    ],
    "produces": [
      {
        "extension": "@cinatra-ai/cms-snapshot-artifact",
        "objectTypeId": "@cinatra-ai/cms-snapshot-artifact:cms-page"
      }
    ],
    "tools": [
      {
        "name": "review_targets",
        "module": "./cinatra/tools/review-targets.mjs"
      }
    ],
    "lifecycle": {
      "repairCapable": true
    },
    "packageType": "agent",
    "manifestVersion": 1,
    "sourceTemplateId": "wordpress-content-editor-flow",
    "sourceVersionId": "2cecbcb9-2163-4938-a523-ed2d178364a3",
    "sourceVersionNumber": 1,
    "riskLevel": "low",
    "hasApprovalGates": false,
    "toolAccess": [],
    "ownerOrgId": null
  }
}
