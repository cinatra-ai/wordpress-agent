{
  "name": "@cinatra-ai/wordpress-agent",
  "version": "0.1.2",
  "license": "Apache-2.0",
  "description": "Edits WordPress posts from natural language instructions via the WordPress MCP server.",
  "type": "module",
  "files": [
    "cinatra"
  ],
  "cinatra": {
    "apiVersion": "cinatra.ai/v1",
    "kind": "agent",
    "displayName": "WordPress Agent",
    "dependencies": [
      {
        "packageName": "@cinatra-ai/wordpress-mcp-connector",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.4"
        },
        "requirement": "required",
        "kind": "connector"
      }
    ],
    "consumes": [
      {
        "primitive": "wordpress_post_get",
        "requirement": "required"
      },
      {
        "primitive": "wordpress_post_update",
        "requirement": "required"
      },
      {
        "primitive": "wordpress_post_update_meta",
        "requirement": "required"
      },
      {
        "primitive": "wordpress_post_create_draft",
        "requirement": "required"
      },
      {
        "primitive": "wordpress_post_delete",
        "requirement": "required"
      },
      {
        "primitive": "wordpress_post_status",
        "requirement": "required"
      }
    ],
    "packageType": "agent",
    "manifestVersion": 1,
    "sourceTemplateId": "wordpress-content-editor-flow",
    "sourceVersionId": "2cecbcb9-2163-4938-a523-ed2d178364a3",
    "sourceVersionNumber": 1,
    "riskLevel": "low",
    "hasApprovalGates": false,
    "toolAccess": [],
    "ownerOrgId": null
  }
}
